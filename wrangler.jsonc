{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novaproxy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "1e220dd0-8396-480c-a3ac-ed5385847ce5","database_name": "novaproxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "02c72bd2b63b4f52960c9d44a7741649" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
